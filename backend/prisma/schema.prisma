generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Relaciones y onDelete (C17: "decidido a conciencia, no por default")
//
//  Usuario 1 ── 0..1 Cliente   onDelete: SetNull  → si se borra la cuenta, la ficha
//                                                   del cliente y su historial quedan.
//  Cliente 1 ── N Vehiculo     onDelete: Cascade  → un vehículo no tiene sentido sin
//                                                   su titular (pero ver Turno abajo).
//  Cliente 1 ── N Turno        onDelete: Restrict → no se borra un cliente con turnos:
//                                                   se perdería el historial.
//  Vehiculo 1 ── N Turno       onDelete: SetNull  → el turno queda en el historial
//                                                   aunque se dé de baja el auto.
//  Servicio 1 ── N Turno       onDelete: Restrict → no se borra un servicio usado.
//  Vehiculo 1 ── N Lavado      onDelete: Restrict → los lavados son la caja del día.
//  Servicio 1 ── N Lavado      onDelete: Restrict → idem.
//  Usuario  1 ── N Lavado      onDelete: Restrict → queda registrado quién lo hizo.
//
// Combinado: borrar un cliente sin turnos borra sus vehículos (Cascade); si tiene
// turnos, Postgres frena todo (Restrict) y la API responde 409.
// ─────────────────────────────────────────────────────────────

enum Rol {
  ADMIN
  EMPLEADO
  CLIENTE
}

enum EstadoTurno {
  PENDIENTE
  CONFIRMADO
  EN_PROCESO
  COMPLETADO
  CANCELADO
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  nombre       String
  passwordHash String
  rol          Rol      @default(CLIENTE)
  createdAt    DateTime @default(now())
  cliente      Cliente?
  lavados      Lavado[]
}

model Cliente {
  id        Int        @id @default(autoincrement())
  nombre    String
  dni       String?    @unique // búsqueda rápida por DNI (Visión y Alcance 5.1)
  telefono  String
  email     String?    @unique
  createdAt DateTime   @default(now())
  usuarioId Int?       @unique
  usuario   Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  vehiculos Vehiculo[]
  turnos    Turno[]
}

model Vehiculo {
  id                 Int       @id @default(autoincrement())
  patente            String    @unique // normalizada: sin espacios ni guiones, en mayúsculas
  marca              String
  modelo             String
  anio               Int?
  km                 Int       @default(0)
  kmUltimoService    Int?
  fechaUltimoService DateTime?
  createdAt          DateTime  @default(now())
  clienteId          Int
  cliente            Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  turnos             Turno[]
  lavados            Lavado[]
}

model Servicio {
  id      Int              @id @default(autoincrement())
  nombre  String
  precio  Float
  desc    String
  tipo    String // "lavadero" | "lubricentro"
  turnos  Turno[]
  lavados Lavado[]
  insumos ServicioInsumo[] // "receta": qué insumos consume cada vez que se hace
}

model Turno {
  id                  Int         @id @default(autoincrement())
  fecha               String // "YYYY-MM-DD"
  hora                String // "HH:MM", uno de los horarios de atención
  estado              EstadoTurno @default(PENDIENTE)
  nota                String?
  createdAt           DateTime    @default(now())
  clienteId           Int
  cliente             Cliente     @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vehiculoId          Int?
  vehiculo            Vehiculo?   @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)
  servicioId          Int
  servicio            Servicio    @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  stockDescontado     Boolean     @default(false) // evita descontar dos veces si se re-completa
  recordatorioEnviado Boolean     @default(false) // el recordatorio automático sale una sola vez
  correos             Correo[]
}

// Lavado "en el momento": el auto llega sin turno y se registra al ingresar.
// precio es una foto del precio del servicio en ese momento (los precios cambian).
model Lavado {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @default(now())
  precio        Float
  observaciones String?
  vehiculoId    Int
  vehiculo      Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  servicioId    Int
  servicio      Servicio @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  empleadoId    Int
  empleado      Usuario  @relation(fields: [empleadoId], references: [id], onDelete: Restrict)
}

// ─────────────────────────────────────────────────────────────
// Control de insumos (Visión y Alcance 5.1)
//  Insumo 1 ── N ServicioInsumo  onDelete: Cascade  → si se borra un insumo, sale de las recetas.
//  Servicio 1 ── N ServicioInsumo onDelete: Cascade  → la receta es parte del servicio.
//  Insumo 1 ── N MovimientoStock onDelete: Cascade  → el historial es del insumo.
// ─────────────────────────────────────────────────────────────

model Insumo {
  id          Int               @id @default(autoincrement())
  nombre      String            @unique
  unidad      String // "litros" | "unidades"
  stock       Float             @default(0)
  stockMinimo Float             @default(0)
  createdAt   DateTime          @default(now())
  servicios   ServicioInsumo[]
  movimientos MovimientoStock[]
}

model ServicioInsumo {
  servicioId Int
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  insumoId   Int
  insumo     Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  cantidad   Float

  @@id([servicioId, insumoId])
}

model MovimientoStock {
  id       Int      @id @default(autoincrement())
  insumoId Int
  insumo   Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  cantidad Float // positivo = carga, negativo = consumo
  motivo   String
  fecha    DateTime @default(now())
}

// Recordatorios por e-mail (Visión y Alcance 5.1). Si no hay SMTP configurado
// el envío queda SIMULADO: se registra igual, para poder mostrarlo.
//  Turno 1 ── N Correo  onDelete: SetNull → el registro del envío queda aunque se borre el turno.
enum EstadoCorreo {
  ENVIADO
  SIMULADO
  FALLIDO
}

model Correo {
  id           Int          @id @default(autoincrement())
  destinatario String
  asunto       String
  cuerpo       String
  estado       EstadoCorreo
  error        String?
  createdAt    DateTime     @default(now())
  turnoId      Int?
  turno        Turno?       @relation(fields: [turnoId], references: [id], onDelete: SetNull)
}

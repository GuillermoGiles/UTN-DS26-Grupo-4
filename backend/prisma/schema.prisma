generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id        Int     @id @default(autoincrement())
  nombre    String
  vehiculo  String
  patente   String  @unique
  telefono  String
  turnos    Turno[]
}

model Servicio {
  id     Int     @id @default(autoincrement())
  nombre String
  precio Float
  desc   String
  tipo   String  // "lavadero" | "lubricentro"
  turnos Turno[]
}

model Turno {
  id         Int      @id @default(autoincrement())
  fecha      String
  hora       String
  clienteId  Int
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  servicioId Int
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Restrict)
}

enum Rol {
  ADMIN
  EMPLEADO
  CLIENTE
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  nombre       String
  passwordHash String
  rol          Rol      @default(CLIENTE)
  createdAt    DateTime @default(now())
}


NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=sgi_sanjose_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}

CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1

# Seguridad y Autenticación (Clase 18)
# Se utiliza para firmar los JSON Web Tokens generados.
JWT_SECRET=cambiame_por_una_cadena_secreta_segura_para_el_tp

# Tiempo de vencimiento del token de sesión (opcional en .env, por defecto '2h' en código).
# Expresado en formato Vercel ms (ej: '2h', '7d', '30m').
# JWT_EXPIRES_IN=2h


NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS, separados por coma (nunca "*").
# En producción: FRONTEND_URL=http://localhost:5173,https://<tu-app>.vercel.app
FRONTEND_URL=http://localhost:5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=sgi_sanjose_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}

CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1

# --- Seguridad y Autenticación (Clase 18 / 20) ---
# Clave con la que se firman los JWT. Cambiala por una cadena larga y aleatoria;
# si se filtra, cualquiera puede fabricar tokens válidos.
JWT_SECRET=cambiame

# Vencimiento del token de sesión (lo lee backend/src/config/env.ts).
# Formato "ms": '30s', '30m', '2h', '7d'. Si se omite, el valor por defecto es 2h.
# Cuando vence, el back responde 401 "Token expirado" y el front cierra la sesión sola.
# Para probar ese flujo en local: poner JWT_EXPIRES_IN=30s, reiniciar la API,
# loguearse, esperar y hacer cualquier request con el token.
JWT_EXPIRES_IN=2h


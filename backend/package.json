{
  "name": "sgi-sanjose-api",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "npx prisma generate && tsx watch src/index.ts",
    "setup": "sh src/setup.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sin-db": "vitest run --exclude \"**/*.db.test.ts\"",
    "coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "prisma": "^7.9.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
